+            let y = _mm256_add_ps(_mm256_mul_ps(_mm256_sub_ps(_mm256_set1_ps(1.0), u), c), keep);
+            _mm256_storeu_ps(hp.add(j), y);
+        }
+    }
+    for j in main..n {
+        let r = sigmoid_fast(gi[j] + gh[j]);
+        let u = sigmoid_fast(gi[n + j] + gh[n + j]);
+        let c = tanh_fast(gi[2 * n + j] + r * gh[2 * n + j]);
+        h[j] = (1.0 - u) * c + u * h[j];
+    }
