th\n\n\nmanifest_bytes = MANIFEST_PATH.read_bytes()\nif hashlib.sha256(manifest_bytes).hexdigest() != MANIFEST_SHA256:\n    raise RuntimeError(\"R14 import smoke saw a different preparation manifest\")\nmanifest = json.loads(manifest_bytes)\nif not isinstance(manifest, dict) or manifest.get(\"schema\") != \"nf19.r14_preparation.v1\":\n    raise RuntimeError(\"unexpected R14 preparation manifest schema\")\nmanifest_files = manifest.get(\"files\")\nif not isinstance(manifest_files, dict):\n    raise RuntimeError(\"R14 manifest files must be an object\")\nmanifest_canonical = {\n    name: digest for name, digest in manifest_files.items() if name.startswith(\"canonical:\")\n}\nif manifest_canonical != CANONICAL_PINS:\n    raise RuntimeError(\"R14 canonical source pins differ from the frozen assembly\")\nif manifest.get(\"runtime_py\") != RUNTIME_PY:\n    raise RuntimeError(\"R14 runtime closure differs from the frozen assembly\")\n\ncanonical_verified: dict[str, str] = {}\nfor pin_name, expected_sha256 in CANONICAL_PINS.items():\n    path = safe_canonical_path(pin_name)\n    if not path.is_file() or path.is_symlink() or sha256_file(path) != expected_sha256:\n        raise RuntimeError(f\"R14 canonical source pin differs: {pin_name}\")\n    canonical_verified[pin_name] = expected_sha256\n\n# Verify each runtime source path and pin before any R14/R1/R3/WNN import.\nfor module_name, relative in RUNTIME_PY.items():\n    if not isinstance(module_name, str) or not isinstance(relative, str):\n        raise RuntimeError(\"R14 runtime_py entries must be string pairs\")\n    expected_sha256 = manifest_files.get(relative)\n    if not isinstance(expected_sha256, str):\n        raise RuntimeError(f\"runtime source is absent from the manifest: {relative}\")\n    path = runtime_path(relative)\n    if not path.is_file() or path.is_symlink() or sha256_file(path) != expected_sha256:\n        raise RuntimeError(f\"R14 runtime source bytes differ: {relative}\")\n\ncalls: list[str] = []\n\n\ndef deny_reader(name: str) -> Callable[..., object]:\n    \"\"\"Build an import-time reader sentinel for metadata and checkpoint loaders.\"\"\"\n\n    def deny(*args: object, **kwargs: object) -> object:\n        calls.append(name)\n        raise AssertionError(f\"R14 cold import attempted a forbidden read through {name}\")\n\n    return deny\n\n\nif os.environ.get(\"CUDA_VISIBLE_DEVICES\", \"\") != \"\":\n    raise RuntimeError(\"R14 CUDA visibility is not hidden\")\nif \"torch\" in sys.modules:\n    raise RuntimeError(\"R14 runtime unexpectedly imported Torch\")\nnp.load = deny_reader(\"numpy.load\")\nnp.memmap = deny_reader(\"numpy.memmap\")\npq.ParquetFile = deny_reader(\"pyarrow.parquet.ParquetFile\")\n\nstarted = time.monotonic()\nimported: dict[str, str] = {}\nfor module_name, relative in RUNTIME_PY.items():\n    module = importlib.import_module(module_name)\n    expected_path = runtime_path(relative).resolve()\n    actual_path = pathlib.Path(str(module.__file__)).resolve()\n    if actual_path != expected_path:\n        raise RuntimeError(f\"R14 import resolved outside its pinned source: {module_name}\")\n    imported[module_name] = str(actual_path)\n\nowned_prefix_roots = tuple(sorted(set(ALLOWED_BUNDLE_ROOTS) | {\"wnn\"}))\nactual_owned_modules = sorted(\n    name\n    for name in sys.modules\n    if any(name == prefix or name.startswith(prefix + \".\") for prefix in owned_prefix_roots)\n)\nexpected_owned_modules = sorted(RUNTIME_PY)\nif actual_owned_modules != expected_owned_modules:\n    missing = sorted(set(expected_owned_modules) - set(actual_owned_modules))\n    unexpected = sorted(set(actual_owned_modules) - set(expected_owned_modules))\n    raise RuntimeError(\n        f\"R14 actual owned module inventory differs: missing={missing}, unexpected={unexpected}\"\n    )\nif calls:\n    raise RuntimeError(f\"R14 cold import attempted forbidden reads: {calls}\")\nif \"torch\" in sys.modules:\n    raise RuntimeError(\"R14 runtime unexpectedly imported Torch\")\n\nsmoke = {\n    \"schema\": \"nf19.r14_import_smoke.v1\",\n    \"status\": \"PASS\",\n    \"observed_utc\": __import__(\"datetime\")\n    .datetime.now(__import__(\"datetime\").timezone.utc)\n    .isoformat(),\n    \"preparation_manifest_sha256\": MANIFEST_SHA256,\n    \"runtime_import_paths\": imported,\n    \"owned_prefix_roots\": list(owned_prefix_roots),\n    \"actual_owned_modules\": actual_owned_modules,\n    \"expected_owned_modules\": expected_owned_modules,\n    \"actual_owned_prefix_module_count\": len(actual_owned_modules),\n    \"runtime_source_sha256\": {\n        relative: manifest_files[relative] for relative in RUNTIME_PY.values()\n    },\n    \"canonical_source_sha256\": canonical_verified,\n    \"reader_sentinel_calls\": calls,\n    \"array_reads\": 0,\n    \"parquet_reads\": 0,\n    \"checkpoint_reads\": 0,\n    \"torch_imported\": False,\n    \"cuda_visible_devices\": os.environ.get(\"CUDA_VISIBLE_DEVICES\", \"\"),\n    \"numpy_version\": np.__version__,\n    \"elapsed_s\": time.monotonic() - started,\n}\nwith (ROOT / \"ROOT_IMPORT_SMOKE.json\").open(\"xb\") as stream:\n    stream.write(json.dumps(smoke, indent=2, sort_keys=True).encode(\"utf-8\"))\n    stream.write(b\"\\n\")\n\narguments = [\n    \"--sample\",\n    str(SAMPLE),\n    \"--output\",\n    str(OUT),\n    \"--expected-sample-sha256\",\n    SAMPLE_SHA256,\n    \"--expected-preparation-manifest-sha256\",\n    MANIFEST_SHA256,\n]\nos.execv(\n    sys.executable,\n    [sys.executable, \"-B\", \"-m\", \"idea_screens_r14.run_probe\", *arguments],\n)\n"
