CES= OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 PYTHONPATH=/home/grinchenkoeg/computer-vision-homework-20261018/source-a266b036/src:/home/grinchenkoeg/computer-vision-homework-20261018/support-source/eda19-r14-v1 TMPDIR=/home/grinchenkoeg/computer-vision-homework-20261018/research_tmp /home/grinchenkoeg/WunderFunder/.venv/bin/python -B -c \"from __future__ import annotations\\n\\nimport hashlib\\nimport importlib\\nimport json\\nimport os\\nimport pathlib\\nimport sys\\nimport time\\nfrom collections.abc import Callable\\n\\nimport numpy as np\\nimport pyarrow.parquet as pq\\n\\nB = pathlib.Path(\\\"/home/grinchenkoeg/computer-vision-homework-20261018\\\")\\nROOT = B / \\\"support-source/eda19-r14-v1\\\"\\nCANONICAL_ROOT = B / \\\"source-a266b036/src\\\"\\nMANIFEST_PATH = ROOT / \\\"idea_screens_r14/PREPARATION_MANIFEST.json\\\"\\nMANIFEST_SHA256 = \\\"3ed272bc6d1efd6ec016c68f73a5efcfe3211c011cb1f60cbb2b28e80b1f7257\\\"\\nCANONICAL_PINS = {'canonical:wnn/__init__.py': '2dca10ee7e2e8c1139bed2165b322d2077fdbeac8095428e8c796efe47ea66c6', 'canonical:wnn/data.py': 'a93da840137adbd7afdb79a22687fb73150e77107f91ca2adc5211b854bc7e00', 'canonical:wnn/gmetric.py': '2cf10e740a831379f62b7d1269456053f5c1f9efa2dbab03156e366972bed5aa'}  # noqa: F821\\nRUNTIME_PY = {'idea_screens_r1': 'idea_screens_r1/__init__.py', 'idea_screens_r1.constants': 'idea_screens_r1/constants.py', 'idea_screens_r1.eda_mechanisms': 'idea_screens_r1/eda_mechanisms.py', 'idea_screens_r1.input_diagnostics': 'idea_screens_r1/input_diagnostics.py', 'idea_screens_r1.sample_data': 'idea_screens_r1/sample_data.py', 'idea_screens_r1.target_operator': 'idea_screens_r1/target_operator.py', 'idea_screens_r14': 'idea_screens_r14/__init__.py', 'idea_screens_r14.history_features': 'idea_screens_r14/history_features.py', 'idea_screens_r14.linear_math': 'idea_screens_r14/linear_math.py', 'idea_screens_r14.panel_data': 'idea_screens_r14/panel_data.py', 'idea_screens_r14.probe_execution': 'idea_screens_r14/probe_execution.py', 'idea_screens_r14.result_payload': 'idea_screens_r14/result_payload.py', 'idea_screens_r14.run_probe': 'idea_screens_r14/run_probe.py', 'idea_screens_r14.runtime_support': 'idea_screens_r14/runtime_support.py', 'idea_screens_r14.score_endpoints': 'idea_screens_r14/score_endpoints.py', 'idea_screens_r3': 'idea_screens_r3/__init__.py', 'idea_screens_r3.probe_helpers': 'idea_screens_r3/probe_helpers.py', 'wnn': 'canonical:wnn/__init__.py', 'wnn.data': 'canonical:wnn/data.py', 'wnn.gmetric': 'canonical:wnn/gmetric.py'}  # noqa: F821\\nSAMPLE = B / \\\"research_tmp/nf19-sample-r3-v2\\\"\\nOUT = B / \\\"research_tmp/nf19-r14-v1\\\"\\nSAMPLE_SHA256 = \\\"b89455ba449f31bb9ebe815976d4da23bb1a8e499e421b6bb5f8d44566f76e64\\\"\\nALLOWED_BUNDLE_ROOTS = {\\n    \\\"idea_screens_r1\\\",\\n    \\\"idea_screens_r3\\\",\\n    \\\"idea_screens_r14\\\",\\n}\\n\\nsys.dont_write_bytecode = True\\n\\n\\ndef sha256_file(path: pathlib.Path) -> str:\\n    \\\"\\\"\\\"Hash one pinned source or manifest file without importing its package.\\\"\\\"\\\"\\n    digest = hashlib.sha256()\\n    with path.open(\\\"rb\\\") as stream:\\n        for chunk in iter(lambda: stream.read(1 << 20), b\\\"\\\"):\\n            digest.update(chunk)\\n    return digest.hexdigest()\\n\\n\\ndef safe_canonical_path(pin_name: str) -> pathlib.Path:\\n    \\\"\\\"\\\"Resolve a canonical semantic pin under the frozen WNN source snapshot.\\\"\\\"\\\"\\n    if not pin_name.startswith(\\\"canonical:wnn/\\\"):\\n        raise RuntimeError(f\\\"unexpected canonical pin namespace: {pin_name}\\\")\\n    relative = pathlib.PurePosixPath(pin_name.removeprefix(\\\"canonical:\\\"))\\n    if (\\n        relative.is_absolute()\\n        or not relative.parts\\n        or \\\"..\\\" in relative.parts\\n        or relative.parts[0] != \\\"wnn\\\"\\n    ):\\n        raise RuntimeError(f\\\"unsafe canonical pin path: {pin_name}\\\")\\n    return CANONICAL_ROOT / relative\\n\\n\\ndef runtime_path(relative: str) -> pathlib.Path:\\n    \\\"\\\"\\\"Resolve a runtime module to either its sealed staged or canonical source file.\\\"\\\"\\\"\\n    if relative.startswith(\\\"canonical:\\\"):\\n        return safe_canonical_path(relative)\\n    path = pathlib.PurePosixPath(relative)\\n    if (\\n        path.is_absolute()\\n        or \\\"..\\\" in path.parts\\n        or not path.parts\\n        or path.parts[0] not in ALLOWED_BUNDLE_ROOTS\\n    ):\\n        raise RuntimeError(f\\\"runtime path escapes the sealed bundle roots: {relative}\\\")\\n    return ROOT / path\\n\\n\\nmanifest_bytes = MANIFEST_PATH.read_bytes()\\nif hashlib.sha256(manifest_bytes).hexdigest() != MANIFEST_SHA256:\\n    raise RuntimeError(\\\"R14 import smoke saw a different preparation manifest\\\")\\nmanifest = json.loads(manifest_bytes)\\nif not isinstance(manifest, dict) or manifest.get(\\\"schema\\\") != \\\"nf19.r14_preparation.v1\\\":\\n    raise RuntimeError(\\\"unexpected R14 preparation manifest schema\\\")\\nmanifest_files = manifest.get(\\\"files\\\")\\nif not isinstance(manifest_files, dict):\\n    raise RuntimeError(\\\"R14 manifest files must be an object\\\")\\nmanifest_canonical = {\\n    name: digest for name, digest in manifest_files.items() if name.startswith(\\\"canonical:\\\")\\n}\\nif manifest_canonical != CANONICAL_PINS:\\n    raise RuntimeError(\\\"R14 canonical source pins differ from the frozen assembly\\\")\\nif manifest.get(\\\"runtime_py\\\") != RUNTIME_PY:\\n    raise RuntimeError(\\\"R14 runtime closure differs from the frozen assembly\\\")\\n\\ncanonical_verified: dict[str, str] = {}\\nfor pin_name, expected_sha256 in CANONICAL_PINS.items():\\n    path = safe_canonical_path(pin_name)\\n    if not path.is_file() or path.is_symlink() or sha256_file(path) != expected_sha256:\\n        raise RuntimeError(f\\\"R14 canonical source pin differs: {pin_name}\\\")\\n    canonical_verified[pin_name] = expected_sha256\\n\\n# Verify each runtime source path and pin before any R14/R1/R3/WNN import.\\nfor module_name, relative in RUNTIME_PY.items():\\n    if not isinstance(module_name, str) or not isinstance(relative, str):\\n        raise RuntimeError(\\\"R14 runtime_py entries must be string pairs\\\")\\n    expected_sha256 = manifest_files.get(relative)\\n    if not isinstance(expected_sha256, str):\\n        raise RuntimeError(f\\\"runtime source is absent from the manifest: {relative}\\\")\\n    path = runtime_path(relative)\\n    if not path.is_file() or path.is_symlink() or sha256_file(path) != expected_sha256:\\n        raise RuntimeError(f\\\"R14 runtime source bytes differ: {relative}\\\")\\n\\ncalls: list[str] = []\\n\\n\\ndef deny_reader(name: str) -> Callable[..., object]:\\n    \\\"\\\"\\\"Build an import-time reader sentinel for metadata and checkpoint loaders.\\\"\\\"\\\"\\n\\n    def deny(*args: object, **kwargs: object) -> object:\\n        calls.append(name)\\n        raise AssertionError(f\\\"R14 cold import attempted a forbidden read through {name}\\\")\\n\\n    return deny\\n\\n\\nif os.environ.get(\\\"CUDA_VISIBLE_DEVICES\\\", \\\"\\\") != \\\"\\\":\\n    raise RuntimeError(\\\"R14 CUDA visibility is not hidden\\\")\\nif \\\"torch\\\" in sys.modules:\\n    raise RuntimeError(\\\"R14 runtime unexpectedly imported Torch\\\")\\nnp.load = deny_reader(\\\"numpy.load\\\")\\nnp.memmap = deny_reader(\\\"numpy.memmap\\\")\\npq.ParquetFile = deny_reader(\\\"pyarrow.parquet.ParquetFile\\\")\\n\\nstarted = time.monotonic()\\nimported: dict[str, str] = {}\\nfor module_name, relative in RUNTIME_PY.items():\\n    module = importlib.import_module(module_name)\\n    expected_path = runtime_path(relative).resolve()\\n    actual_path = pathlib.Path(str(module.__file__)).resolve()\\n    if actual_path != expected_path:\\n        raise RuntimeError(f\\\"R14 import resolved outside its pinned source: {module_name}\\\")\\n    imported[module_name] = str(actual_path)\\n\\nowned_prefix_roots = tuple(sorted(set(ALLOWED_BUNDLE_ROOTS) | {\\\"wnn\\\"}))\\nactual_owned_modules = sorted(\\n    name\\n    for name in sys.modules\\n    if any(name == prefix or name.startswith(prefix + \\\".\\\") for prefix in owned_prefix_roots)\\n)\\nexpected_owned_modules = sorted(RUNTIME_PY)\\nif actual_owned_modules != expected_owned_modules:\\n    missing = sorted(set(expected_owned_modules) - set(actual_owned_modules))\\n    unexpected = sorted(set(actual_owned_modules) - set(expected_owned_modules))\\n    raise RuntimeError(\\n        f\\\"R14 actual owned module inventory differs: missing={missing}, unexpected={unexpected}\\\"\\n    )\\nif calls:\\n    raise RuntimeError(f\\\"R14 cold import attempted forbidden reads: {calls}\\\")\\nif \\\"torch\\\" in sys.modules:\\n    raise RuntimeError(\\\"R14 runtime unexpectedly imported Torch\\\")\\n\\nsmoke = {\\n    \\\"schema\\\": \\\"nf19.r14_import_smoke.v1\\\",\\n    \\\"status\\\": \\\"PASS\\\",\\n    \\\"observed_utc\\\": __import__(\\\"datetime\\\")\\n    .datetime.now(__import__(\\\"datetime\\\").timezone.utc)\\n    .isoformat(),\\n    \\\"preparation_manifest_sha256\\\": MANIFEST_SHA256,\\n    \\\"runtime_import_paths\\\": imported,\\n    \\\"owned_prefix_roots\\\": list(owned_prefix_roots),\\n    \\\"actual_owned_modules\\\": actual_owned_modules,\\n    \\\"expected_owned_modules\\\": expected_owned_modules,\\n    \\\"actual_owned_prefix_module_count\\\": len(actual_owned_modules),\\n    \\\"runtime_source_sha256\\\": {\\n        relative: manifest_files[relative] for relative in RUNTIME_PY.values()\\n    },\\n    \\\"canonical_source_sha256\\\": canonical_verified,\\n    \\\"reader_sentinel_calls\\\": calls,\\n    \\\"array_reads\\\": 0,\\n    \\\"parquet_reads\\\": 0,\\n    \\\"checkpoint_reads\\\": 0,\\n    \\\"torch_imported\\\": False,\\n    \\\"cuda_visible_devices\\\": os.environ.get(\\\"CUDA_VISIBLE_DEVICES\\\", \\\"\\\"),\\n    \\\"numpy_version\\\": np.__version__,\\n    \\\"elapsed_s\\\": time.monotonic() - started,\\n}\\nwith (ROOT / \\\"ROOT_IMPORT_SMOKE.json\\\").open(\\\"xb\\\") as stream:\\n    stream.write(json.dumps(smoke, indent=2, sort_keys=True).encode(\\\"utf-8\\\"))\\n    stream.write(b\\\"\\\\n\\\")\\n\\narguments = [\\n    \\\"--sample\\\",\\n    str(SAMPLE),\\n    \\\"--output\\\",\\n    str(OUT),\\n    \\\"--expected-sample-sha256\\\",\\n    SAMPLE_SHA256,\\n    \\\"--expected-preparation-manifest-sha256\\\",\\n    MANIFEST_SHA256,\\n]\\nos.execv(\\n    sys.executable,\\n    [sys.executable, \\\"-B\\\", \\\"-m\\\", \\\"idea_screens_r14.run_probe\\\", *arguments],\\n)\\n\"", "AccessSELinuxContext": "", "LoadState": "loaded", "ActiveState": "active", "FreezerState": "running", "SubState": "exited", "FragmentPath": "/run/user/1061/systemd/transient/computer-vision-homework-eda19-r14-v1.service", "SourcePath": "", "DropInPaths": "", "UnitFileState": "transient", "UnitFilePreset": "enabled", "StateChangeTimestamp": "Mon 2026-10-19 06:59:02 UTC", "StateChangeTimestampMonotonic": "1450389931868", "InactiveExitTimestamp": "Mon 2026-10-19 06:58:00 UTC", "InactiveExitTimestampMonotonic": "1450327438440", "ActiveEnterTimestamp": "Mon 2026-10-19 06:58:00 UTC", "ActiveEnterTimestampMonotonic": "1450327440816", "ActiveExitTimestamp": "", "ActiveExitTimestampMonotonic": "0", "InactiveEnterTimestamp": "", "InactiveEnterTimestampMonotonic": "0", "CanStart": "yes", "CanStop": "yes", "CanReload": "no", "CanIsolate": "no", "CanClean": "", "CanFreeze": "yes", "Job": "", "StopWhenUnneeded": "no", "RefuseManualStart": "no", "RefuseManualStop": "no", "AllowIsolate": "no", "DefaultDependencies": "yes", "SurviveFinalKillSignal": "no", "OnSuccessJobMode": "fail", "OnFailureJobMode": "replace", "IgnoreOnIsolate": "no", "NeedDaemonReload": "no", "Markers": "", "JobTimeoutUSec": "infinity", "JobRunningTimeoutUSec": "infinity", "JobTimeoutAction": "none", "JobTimeoutRebootArgument": "", "ConditionResult": "yes", "AssertResult": "yes", "ConditionTimestamp": "Mon 2026-10-19 06:58:00 UTC", "ConditionTimestampMonotonic": "1450327423827"