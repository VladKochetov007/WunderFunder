{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E465 TPU immutable input manifest",
  "type": "object",
  "required": [
    "format",
    "version",
    "fold_manifest",
    "fold_manifest_sha256",
    "teacher_runs",
    "propensity_run",
    "parent_export",
    "files"
  ],
  "properties": {
    "format": {"const": "wnn.e465-tpu-input-manifest"},
    "version": {"const": 1},
    "fold_manifest": {"type": "string", "minLength": 1},
    "fold_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "teacher_runs": {
      "const": ["c20260929_since_s3_f0", "c20260929_since_s4_f0"]
    },
    "propensity_run": {"const": "c20260929_prop_f0"},
    "parent_export": {
      "type": "object",
      "required": [
        "run",
        "epoch",
        "weight_source",
        "npz_path",
        "npz_sha256",
        "sidecar_path",
        "sidecar_sha256",
        "source_checkpoint_path",
        "source_checkpoint_sha256",
        "source_provenance_path",
        "source_provenance_sha256",
        "dimensions"
      ],
      "properties": {
        "run": {"const": "c20261003_combo_s3_f0"},
        "epoch": {"const": 3},
        "weight_source": {"const": "evaluation_ema"},
        "npz_path": {"type": "string", "minLength": 1},
        "npz_sha256": {"$ref": "#/$defs/sha256"},
        "sidecar_path": {"type": "string", "minLength": 1},
        "sidecar_sha256": {"$ref": "#/$defs/sha256"},
        "source_checkpoint_path": {"type": "string", "minLength": 1},
        "source_checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "source_provenance_path": {"type": "string", "minLength": 1},
        "source_provenance_sha256": {"$ref": "#/$defs/sha256"},
        "dimensions": {
          "const": {"n_in": 211, "hidden": 256, "layers": 2, "n_out": 23}
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
