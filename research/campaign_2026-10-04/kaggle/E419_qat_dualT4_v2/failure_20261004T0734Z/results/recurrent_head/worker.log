        controlled: bool,
        research_features: str = "none",
        origin_view: str = "off",
        credit_mode: str = "deterministic",
        keep_probability: float = 0.5,
        qat: str = "none",
        recurrent_rank: int = 0,
        sentinel_arm: tuple[str, str] | None = None,
        thin_mode: str | None = None,
    ) -> None:
