                "--ema-reference-rows",
                "4",
                "--optim",
                "muon",
                "--optim-switch",
                "0.5:adamw",
                "--grad-noise",
                "1e-6",
                "--batch-order",
                "seeded",
                "--antithetic",
            ]
        if device == "cuda":
            base += ["--fast"] if credit_mode == "deterministic" else ["--pin-memory", "--prop-cache"]
        if origin_view != "off":
