        monkeypatch.setattr(training, "dev_halves", lambda path: (np.arange(2), np.arange(2, 4)))
        monkeypatch.setenv("WNN_LOADER_WORKERS", "2" if device == "cuda" else "0")
        monkeypatch.delenv("WNN_PORTABLE_DATA_MANIFEST", raising=False)
        base = [
