{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Additive research bandit tree config v1",
  "type": "object",
  "required": [
    "version",
    "root",
    "families",
    "curated_nodes",
    "documents"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "root": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": true
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "keywords"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "curated_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "parent_id",
          "title",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "parent_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "arm",
              "lineage"
            ]
          },
          "hypothesis_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^H-[0-9]+$"
            }
          },
          "experiment_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^E-[0-9]+$"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related_nodes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          },
          "next_test": {
            "type": "string"
          },
          "belief": {
            "type": "object",
            "properties": {
              "mu": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "sd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "noise_sd": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "reviewed": {
                "type": "boolean"
              },
              "unit": {
                "const": "absolute_global_wp_delta"
              }
            },
            "additionalProperties": true
          },
          "cost_h": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "allocation": {
            "type": "object",
            "properties": {
              "eligible": {
                "type": "boolean"
              },
              "priority": {
                "type": "integer"
              },
              "launch_authorized": {
                "const": false
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "journal": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
