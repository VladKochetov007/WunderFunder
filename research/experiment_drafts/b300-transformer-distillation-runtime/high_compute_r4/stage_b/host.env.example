# Copy outside the checkout and fill the receiver-specific bindings.
# Source this private copy only in a separate R4-B shell after the current four
# fits AND their evaluation have ended and the operator has released all 8 GPUs.
export WNN_EXPECTED_COMMIT='SET_REVIEWED_FULL_COMMIT_SHA'
export WNN_DATA_ROOT='/data/epanov_s/tabdata/data'
export WNN_SPLIT_F0='/data/epanov_s/tabdata/splits/fold0.json'
export WNN_SPLIT_F2='/data/epanov_s/tabdata/splits/fold2.json'
export WNN_INPUTS_ROOT='/data/epanov_s/tabdata/splits/r4-stage-b-lr-20261024-r1'
export WNN_CAMPAIGN_ROOT='/data/epanov_s/tabdata/runs/r4-stage-b-lr-20261024-r1'
export CUDA_VISIBLE_DEVICES='SET_EIGHT_RELEASED_GPU_UUIDS_COMMA_SEPARATED'
export WNN_HOST_RAM_BUDGET_GIB='SET_ACTUAL_ALLOCATED_HOST_RAM_GIB'
export WNN_REVIEWER='SET_RECEIVING_OPERATOR'
export OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
export CUBLAS_WORKSPACE_CONFIG=:4096:8
export CUBLAS_EMULATE_SINGLE_PRECISION=1
