{
  "schema_version": 1,
  "epochs": 4,
  "batch_size": 8,
  "accumulate_chunks": 4,
  "chunk_rows": 1024,
  "seed": 1001,
  "lr": 0.0003,
  "weight_decay": 0.01,
  "optimizer": "adamw",
  "adamw_beta1": 0.9,
  "adamw_beta2": 0.999,
  "adamw_eps": 1e-8,
  "grad_clip": 1.0,
  "warmup_fraction": 0.05,
  "schedule": "warmup_cosine_v2",
  "min_lr_ratio": 0.0,
  "normalization_sequences": 10325,
  "normalization_scope": "all_fit",
  "training_mask": "all_after_warmup",
  "required_world_size": 1,
  "precision_mode": "fp32",
  "checkpoint_retention": "all_epochs",
  "model": {
    "architecture": "transformer",
    "input_feature_mode": "event211",
    "hidden": 384,
    "layers": 8,
    "heads": 8,
    "ff_multiplier": 4,
    "context_rows": 1024,
    "dropout": 0.0,
    "checkpoint_blocks": true,
    "hint_dim": 0,
    "hint_projection": "learned",
    "attention_backend": "math",
    "compile_blocks": false
