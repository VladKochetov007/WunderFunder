FROM python:3.11-slim-bookworm

# Build this image on the receiving machine before disconnecting the scorer.
# Evaluation itself runs with --network none and a read-only checkout.
RUN apt-get update \
    && apt-get install --no-install-recommends -y libstdc++6 libgomp1 \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir numpy==2.2.6 pyarrow==19.0.1

ENV OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /work
