# These execution files are byte-bound to native receipts; do not translate EOLs.
configs/*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
receiving/*.py -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
profile-plan.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
evidence/*.xml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
