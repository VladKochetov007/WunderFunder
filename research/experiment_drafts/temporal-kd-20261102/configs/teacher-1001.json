{
  "schema_version": 1,
  "model": {
    "ff_multiplier": 4,
    "dropout": 0.0,
    "checkpoint_blocks": true,
    "hint_dim": 0,
    "hint_projection": "fixed",
    "context_rows": 512,
    "architecture": "transformer",
    "hidden": 768,
    "layers": 24,
    "heads": 12
  },
  "epochs": 5,
  "batch_size": 1,
  "accumulate_chunks": 4,
  "chunk_rows": 256,
  "seed": 1001,
  "lr": 0.0001,
  "weight_decay": 0.01,
  "grad_clip": 1.0,
  "warmup_fraction": 0.05,
  "kd_weight": 0.0,
  "hint_weight": 0.0,
  "hint_mode": "aligned",
  "normalization_sequences": 32,
  "precision_mode": "fp32",
  "required_device": "B300",
  "required_world_size": 1,
  "normalization_scope": "all_fit",
  "training_mask": "is_scored",
  "checkpoint_retention": "final_only",
  "train_source_only": true,
  "optimizer": "muon",
  "muon_momentum": 0.95,
  "muon_ns_steps": 5,
  "muon_ns_eps": 1e-07,
  "adamw_beta1": 0.9,
  "adamw_beta2": 0.95,
  "adamw_eps": 1e-08,
  "schedule": "warmup_cosine_v2",
  "min_lr_ratio": 0.1
}
