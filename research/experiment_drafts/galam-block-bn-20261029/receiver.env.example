# Copy outside the checkout and replace every path/identity before sourcing.
# This is a preparation example, not a reference to the live PR46 worker.
export PYTHON_EXECUTABLE=/srv/venvs/wunder/bin/python
export CUDA_VISIBLE_DEVICES=0
export GALAM_SOURCE=/srv/checkouts/galam-block-bn
export GALAM_COMMIT=REPLACE_WITH_REVIEWED_40_CHARACTER_COMMIT
export GALAM_OUTPUT=/srv/experiments/galam-block-bn-new-attempt
export GALAM_DATA=/srv/data/connectome
export GALAM_SPLIT=/srv/prepared/chronological_primary.json
# Use an immutable copied epoch checkpoint and its complete original epoch index.
export GALAM_CHECKPOINT=/srv/checkpoint-snapshots/gru72/epoch_checkpoints/epoch-000007-REPLACE_WITH_CHECKPOINT_SHA256.pt
export GALAM_CHECKPOINT_SHA256=REPLACE_WITH_PINNED_CHECKPOINT_SHA256
export GALAM_EPOCH_INDEX=/srv/checkpoint-snapshots/gru72/epoch_index.json
# Canonical index_sha256 field from the producer index, NOT sha256sum(file).
export GALAM_EPOCH_INDEX_SHA256=REPLACE_WITH_PINNED_EPOCH_INDEX_SHA256
export GALAM_TRAINING_SOURCE_SHA256=REPLACE_WITH_ORIGINAL_TRAINING_SOURCE_SHA256
