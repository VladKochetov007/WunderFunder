{
  "schema_version": 1,
  "epochs": 30,
  "batch_size": 1,
  "accumulate_chunks": 4,
  "chunk_rows": 256,
  "seed": 1001,
  "lr": 0.0003,
  "weight_decay": 0.01,
  "optimizer": "adamw",
  "adamw_beta1": 0.9,
  "adamw_beta2": 0.95,
  "adamw_eps": 1e-8,
  "grad_clip": 1.0,
  "warmup_fraction": 0.05,
  "schedule": "warmup_cosine_v2",
  "min_lr_ratio": 0.1,
  "kd_weight": 1.0,
  "hint_weight": 0.0,
  "hint_mode": "aligned",
  "normalization_sequences": 32,
  "training_mask": "all_after_warmup",
  "normalization_scope": "all_fit",
  "precision_mode": "bf16_bf16x9",
  "required_world_size": 1,
  "required_device": "B300",
  "expected_fold": 0,
  "checkpoint_retention": "final_only",
  "model": {
    "architecture": "transformer",
    "hidden": 128,
    "layers": 2,
    "heads": 4,
    "ff_multiplier": 4,
    "ff_activation": "gelu",
    "ff_hidden": 512,
    "context_rows": 128,
    "dropout": 0.0,
    "checkpoint_blocks": false,
    "hint_dim": 0,
    "hint_projection": "fixed",
    "attention_backend": "efficient",
    "compile_blocks": true
  }
}
