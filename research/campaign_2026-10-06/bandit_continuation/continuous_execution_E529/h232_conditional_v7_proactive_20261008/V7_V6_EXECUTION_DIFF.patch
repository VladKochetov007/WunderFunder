+def test_proactive_veto_can_continue_above_hard_gates_but_hard_pressure_aborts() -> None:
+    # A proactive eligibility veto leaves enforcement to the unchanged hard gates.
+    assert not unrecovered_relief_requires_abort(
+        hard_pressure_at_trigger=False,
+        hard_gates_pass_after=True,
+    )
+    # A missed recovery margin after an actual hard-gate breach remains fail-closed.
+    assert unrecovered_relief_requires_abort(
+        hard_pressure_at_trigger=True,
+        hard_gates_pass_after=True,
+    )
+    assert unrecovered_relief_requires_abort(
+        hard_pressure_at_trigger=False,
+        hard_gates_pass_after=False,
+    )
