+def cgroup_relief_trigger_state(
+    available_bytes: int,
+    available_fraction: float,
+    *,
+    hard_minimum_bytes: int,
+    hard_minimum_fraction: float,
+    proactive_fraction: float = PROACTIVE_CGROUP_HEADROOM_FRACTION,
+) -> tuple[bool, bool]:
+    """Return whether to attempt relief and whether a hard gate already failed."""
+    hard_pressure = (
+        available_bytes < hard_minimum_bytes or available_fraction < hard_minimum_fraction
+    )
+    proactive_pressure = available_fraction < proactive_fraction
+    return hard_pressure or proactive_pressure, hard_pressure
+
+
+def cgroup_hard_headroom_passes(
+    available_bytes: int,
+    available_fraction: float,
+    *,
+    minimum_bytes: int,
+    minimum_fraction: float,
+) -> bool:
+    """Check the unchanged byte and fraction gates for one cgroup sample."""
+    return available_bytes >= minimum_bytes and available_fraction >= minimum_fraction
+
+
+def unrecovered_relief_requires_abort(
+    *,
+    hard_pressure_at_trigger: bool,
+    hard_gates_pass_after: bool,
+) -> bool:
+    """Abort failed recovery only for an existing or persistent hard violation."""
+    return hard_pressure_at_trigger or not hard_gates_pass_after
