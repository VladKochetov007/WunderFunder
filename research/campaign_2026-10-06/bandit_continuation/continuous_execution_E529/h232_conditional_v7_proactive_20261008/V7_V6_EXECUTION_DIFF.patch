+def test_v6_terminal_snapshot_is_caught_before_the_unchanged_hard_gate() -> None:
+    basis = Path(__file__).resolve().parents[1] / "basis/V6_TERMINAL_POLL_RECEIPT.json"
+    receipt_bytes = basis.read_bytes()
+    assert hashlib.sha256(receipt_bytes).hexdigest() == (
+        "95e5ddbb8027d1f8bbc56326dbde64c7943373bfd4edcb8b17720005f906b503"
+    )
+    receipt = json.loads(receipt_bytes)
+    diagnosis = receipt["resource_diagnosis"]
+    event = diagnosis["last_cache_relief_event"]
+    assert event["range_count"] == 280
+    assert event["range_bytes_requested"] == MAX_ADVICE_BYTES
+    assert event["range_bytes_cap"] == MAX_ADVICE_BYTES
+    assert event["sum_of_range_lengths"] == MAX_ADVICE_BYTES
+    assert event["file_identity_basis"] == (
+        "rowgroup_reads.tsv plus verified train/valid immutable raw-input identity"
+    )
+    after = event["after_advice"]
+    limit = after["cgroup_memory_limit_bytes"]
+    available = after["cgroup_available_bytes"]
+    fraction = after["cgroup_available_fraction"]
+
+    should_attempt, hard_pressure = cgroup_relief_trigger_state(
+        available,
+        fraction,
+        hard_minimum_bytes=6_500_000_000,
+        hard_minimum_fraction=0.25,
+    )
+    assert should_attempt
+    assert not hard_pressure
+    assert fraction == 0.2628669738769531
+    assert PROACTIVE_CGROUP_HEADROOM_FRACTION == 0.28
+    assert cgroup_hard_headroom_passes(
+        available,
+        fraction,
+        minimum_bytes=6_500_000_000,
+        minimum_fraction=0.25,
+    )
+    assert available - int(limit * 0.25) == 414_474_240
+
+    target = relief_target_bytes(limit, 6_500_000_000, 0.25)
+    assert target == 8_565_063_680
+    assert target - available == 97_525_760
+
+    before = event["before_advice"]
+    should_attempt_before, hard_pressure_before = cgroup_relief_trigger_state(
+        before["cgroup_available_bytes"],
+        before["cgroup_available_fraction"],
+        hard_minimum_bytes=6_500_000_000,
+        hard_minimum_fraction=0.25,
+    )
+    assert should_attempt_before
+    assert hard_pressure_before
+
