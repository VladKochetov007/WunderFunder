+@pytest.mark.parametrize(
+    "runtype", ["ssh_direc ssh_proxy", "ssh_direct ssh_proxy", "ssh_direc", "", None, 5]
+)
+def test_create_payload_rejects_malformed_or_combined_runtype(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch, runtype: object
+) -> None:
+    """A future request must select the documented single direct-SSH mode."""
+    intent_path, _, _, _ = make_attempt(tmp_path, monkeypatch)
+    intent = vast._read_object(intent_path)
+    intent["create_payload"]["runtype"] = runtype
+    with pytest.raises(vast.CampaignError, match="SSH direct runtype"):
+        vast._validate_intent(intent, intent_path)
+
+
+def test_create_payload_preserves_single_documented_runtype(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    """The request sent later remains byte-bound to the approved direct mode."""
+    intent_path, _, _, _ = make_attempt(tmp_path, monkeypatch)
+    intent = vast._read_object(intent_path)
+    normalized = vast._validate_intent(intent, intent_path)
+    assert normalized["create_payload"]["runtype"] == "ssh_direct"
+    assert normalized["create_payload"] == intent["create_payload"]
+
