"""Create-only collection and JSON binding checks for the frozen R01 F0 grade.

This program copies only two prediction arrays, their sidecars, the grade, three
attempt records/logs, and small plan/fold/terminal evidence. It never imports
NumPy, opens checkpoint or dataset payloads, or reruns the grader.

Version 2 records the actual split grader layout: its entrypoint lives in a
grader-only checkout while the imported ``wnn`` modules come from the frozen
campaign source tree selected by the bandit worker's ``PYTHONPATH``.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import math
import os
import shutil
import stat
import struct
import sys
import time
from pathlib import Path
from typing import Any

