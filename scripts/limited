#!/usr/bin/env bash
# Run a research command inside a transient systemd scope so it cannot take the
# laptop down: CPU quota (default one core), a hard memory cap
# with swap disabled (the job is OOM-killed inside its cgroup, not the desktop),
# and lowered CPU/IO priority.
#
#   scripts/limited .venv/bin/python scripts/train_rnn.py ...
#
# Explicit job bounds override defaults; the campaign parent caps aggregate CPU.
set -euo pipefail

mem_max=${WNN_MEM_MAX:-30G}
threads=${WNN_THREADS:-1}
(( threads < 1 )) && threads=1
quota=${WNN_CPU_QUOTA:-100%}
scope_properties=(--slice="${WNN_SLICE:-wnn-campaign.slice}")
research_tmp=${WNN_TMP_ROOT:-/home/vlad/development/wunder/research_tmp}
mkdir -p "$research_tmp"
export TMPDIR="$research_tmp"
export TMP="$research_tmp"
export TEMP="$research_tmp"
export WNN_TMP_ROOT="$research_tmp"
export TORCHINDUCTOR_CACHE_DIR="$research_tmp/torchinductor"
if [[ -n ${WNN_RUNTIME_MAX:-} ]]; then
    scope_properties+=(-p "RuntimeMaxSec=$WNN_RUNTIME_MAX")
    scope_properties+=(-p "TimeoutStopSec=2s")
fi
if [[ -n ${WNN_SCOPE_UNIT:-} ]]; then
    scope_properties+=(--unit="$WNN_SCOPE_UNIT")
fi

export WNN_THREADS=$threads
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-$threads}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-$threads}
export OPENBLAS_NUM_THREADS=${OPENBLAS_NUM_THREADS:-$threads}
export NUMBA_NUM_THREADS=${NUMBA_NUM_THREADS:-$threads}
export POLARS_MAX_THREADS=${POLARS_MAX_THREADS:-$threads}
export ARROW_NUM_THREADS=${ARROW_NUM_THREADS:-$threads}

exec systemd-run --user --scope --quiet \
    "${scope_properties[@]}" \
    -p CPUQuota="$quota" \
    -p MemoryMax="$mem_max" \
    -p MemorySwapMax=0 \
    -- nice -n 10 ionice -c 3 "$@"
